<SonarQubeAnalysisProperties  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">
    <!-- optional properties -->
    <Property Name="sonar.host.url">https://sonarcloud.io</Property>
    <Property Name="sonar.qualitygate.wait">true</Property>
    <Property Name="sonar.scanner.skipJreProvisioning">true</Property>
    <Property Name="sonar.coverageReportPaths">./Dfe.ManageFreeSchoolProjects/CoverageReport/SonarQube.xml</Property>

    <!-- coverage exclusions -->
    <Property Name="sonar.coverage.exclusions">**/Dfe.ManageFreeSchoolProjects.CypressTests/**,**/cypress/**,**/Pages/Shared/Footer/_Footer.cshtml</Property>

    <!-- duplication exclusions -->
    <Property Name="sonar.cpd.exclusions">**/Dfe.ManageFreeSchoolProjects.CypressTests/cypress/e2e/**</Property>

    <!-- issue exclusions -->
    <!-- e1: the check your answers rows are built in an @functions helper, so the HTML analyser sees
         the <dt>/<dd> as a bare fragment. At runtime every row is emitted inside the
         <dl class="govuk-summary-list"> that wraps them, so the rendered markup is valid. -->
    <Property Name="sonar.issue.ignore.multicriteria">e1</Property>
    <Property Name="sonar.issue.ignore.multicriteria.e1.ruleKey">Web:ItemTagNotWithinContainerTagCheck</Property>
    <Property Name="sonar.issue.ignore.multicriteria.e1.resourceKey">**/Proposals/Create/CheckYourAnswers.cshtml</Property>
</SonarQubeAnalysisProperties>
