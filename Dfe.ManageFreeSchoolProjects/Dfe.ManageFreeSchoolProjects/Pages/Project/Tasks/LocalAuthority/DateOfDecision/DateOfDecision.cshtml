@page "/projects/{projectId}/tasks/local-authority/date-of-decision"
@using Dfe.ManageFreeSchoolProjects.Constants;

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.DateOfDecision.DateOfDecisionModel

@{
    ViewData["Title"] = $"Edit Date of decision - {Model.CurrentFreeSchoolName}";
    var backLink = string.Format(RouteConstants.TaskList, Model.ProjectId);
}

@section BeforeMain {
    <div role="navigation" class="govuk-extra-width-container">
        <a href=@backLink class="govuk-back-link">Back</a>
    </div>
}

<partial name="_ErrorSummary" />

<h1 class="govuk-heading-xl" data-testid="title">
    <span class="govuk-caption-l" data-testid="school-name">
        @Model.CurrentFreeSchoolName
    </span>
    When will a decision be made?
</h1>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <govuk-date-input id="date-of-decision" name="date-of-decision" asp-for="@Model.DateOfDecision" data-testid="date-of-decision" label="Date of decision" hint="For example, 1 9 2023" />

            <button class="govuk-button" data-module="govuk-button">
                Save and return
            </button>
        </form>
    </div>
</div>
