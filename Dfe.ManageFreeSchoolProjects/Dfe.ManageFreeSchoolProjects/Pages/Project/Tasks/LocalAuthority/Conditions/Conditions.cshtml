@page "/projects/{projectId}/tasks/local-authority/conditions"
@using Dfe.ManageFreeSchoolProjects.Constants;
@using Dfe.ManageFreeSchoolProjects.Enums

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.Conditions.ConditionsModel

@{
    ViewData["Title"] = $"Edit Conditions - {Model.CurrentFreeSchoolName}";
    var backLink = string.Format(RouteConstants.TaskList, Model.ProjectId);
}

@section BeforeMain {
    <nav class="govuk-extra-width-container">
        <a href=@backLink class="govuk-back-link">Back</a>
    </nav>
}

<partial name="_ErrorSummary" />

<h1 class="govuk-heading-xl" data-testid="title">
    <span class="govuk-caption-l" data-testid="school-name">
        @Model.CurrentFreeSchoolName
    </span>
    Have any conditions been applied?
</h1>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <div class="govuk-form-group">
                <govuk-radios-list>
                    <govuk-radios-list-conditional-item id="@YesNoOption.Yes" value="@YesNoOption.Yes" description="@YesNoOption.Yes" asp-for="@Model.ConditionOption" name="ConditionOption" revealed-field-id="@Model.ConditionDescription">
                        <govuk-textarea-input id="@Model.ConditionDescription"
                                              name="condition-description"
                                              asp-for="@Model.ConditionDescription"
                                              test-id="condition-description"
                                              rows="10"
                                              label="What conditions have been applied?"
                                              bold-label="true" />
                    </govuk-radios-list-conditional-item>
                    <govuk-radios-list-item id="@YesNoOption.No" value="@YesNoOption.No" description="@YesNoOption.No" asp-for="@Model.ConditionOption" name="ConditionOption" />
                </govuk-radios-list>
            </div>

            <button class="govuk-button" data-module="govuk-button">
                Save and return
            </button>
        </form>
    </div>
</div>