@page "/projects/{projectId}/tasks/local-authority/conditions"
@using Dfe.ManageFreeSchoolProjects.Constants;
@using Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.Conditions

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.Conditions.ConditionsModel

@{
    ViewData["Title"] = $"Edit Conditions - {Model.CurrentFreeSchoolName}";
    var backLink = string.Format(RouteConstants.TaskList, Model.ProjectId);
}

@section BeforeMain {
    <div role="navigation" class="govuk-extra-width-container">
        <a href=@backLink class="govuk-back-link">Back</a>
    </div>
}
GovUk.Frontend.AspNetCore
<partial name="_ErrorSummary" />

<h1 class="govuk-heading-xl" data-testid="title">
    <span class="govuk-caption-l" data-testid="school-name">
        @Model.CurrentFreeSchoolName
    </span>
    Have any conditions been applied?
</h1>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <govuk-radios name="ConditionOption" asp-for="ConditionOption">
                <govuk-radios-fieldset>
                    <govuk-radios-item data-cy="@YesNoOption.No" value="@YesNoOption.No">No</govuk-radios-item>
                    <govuk-radios-item data-cy="@YesNoOption.Yes" value="@YesNoOption.Yes">
                        Yes
                        <govuk-radios-item-conditional>
                            <p>What conditions have been applied?</p>
                            <govuk-textarea data-cy="condition-description" asp-for="ConditionDescription">
                            
                            </govuk-textarea>
                        </govuk-radios-item-conditional>
                    </govuk-radios-item>
                </govuk-radios-fieldset>
            </govuk-radios>
                       
            <button class="govuk-button" data-module="govuk-button">
                Save and return
            </button>
        </form>
    </div>
</div>