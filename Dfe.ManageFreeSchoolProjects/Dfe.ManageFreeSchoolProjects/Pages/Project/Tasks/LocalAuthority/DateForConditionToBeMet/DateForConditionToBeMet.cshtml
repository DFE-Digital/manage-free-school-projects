@page "/projects/{projectId}/tasks/local-authority/date-conditions-met"
@using Dfe.ManageFreeSchoolProjects.Constants;

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.DateForConditionToBeMet.DateForConditionToBeMetModel

@{
    ViewData["Title"] = $"Edit Specification publication date - {Model.CurrentFreeSchoolName}";
    var backLink = string.Format(RouteConstants.TaskList, Model.ProjectId);
}

@section BeforeMain {
    <div role="navigation" class="govuk-extra-width-container">
        <a href=@backLink class="govuk-back-link">Back</a>
    </div>
}

<partial name="_ErrorSummary" />

<h1 class="govuk-heading-xl" data-testid="title">
    <span class="govuk-caption-l" data-testid="school-name">
        @Model.CurrentFreeSchoolName
    </span>
    When must the conditions be met by?
</h1>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <govuk-date-input id="date-conditions-met" name="date-conditions-met" asp-for="@Model.DateForConditionsToBeMet" data-testid="date-conditions-met" label="Date for conditions to be met" hint="For example, 1 9 2023" />

            <button class="govuk-button" data-module="govuk-button">
                Save and return
            </button>
        </form>
    </div>
</div>