@page "/projects/{projectId}/tasks/local-authority/decision-maker"
@using Dfe.ManageFreeSchoolProjects.Constants;

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.DecisionMaker.DecisionMakerModel

@{
    ViewData["Title"] = $"Edit Decision maker - {Model.CurrentFreeSchoolName}";
    var backLink = string.Format(RouteConstants.TaskList, Model.ProjectId);
}

@section BeforeMain {
    <div role="navigation" class="govuk-extra-width-container">
        <a href=@backLink class="govuk-back-link">Back</a>
    </div>
}

<partial name="_ErrorSummary" />

<h1 class="govuk-heading-xl" data-testid="title">
    <span class="govuk-caption-l" data-testid="school-name">
        @Model.CurrentFreeSchoolName
    </span>
    Who is the decision maker?
</h1>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <div class="govuk-form-group">
                <govuk-radios-input name="decision-maker"
                                    asp-for="@Model.DecisionMaker"
                                    data-testid="decision-maker"
                                    labels="@Model.Options.ToArray()"
                                    values="@Model.Options.ToArray()" />
            </div>

            <button class="govuk-button" data-module="govuk-button">
                Save and return
            </button>
        </form>
    </div>
</div>
