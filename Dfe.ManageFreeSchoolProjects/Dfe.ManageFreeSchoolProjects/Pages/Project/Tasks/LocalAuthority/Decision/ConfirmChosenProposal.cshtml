@page "/projects/{projectId}/tasks/local-authority/{proposalId}/confirm-chosen-proposal"
@using Dfe.ManageFreeSchoolProjects.Constants;

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.Decision.ConfirmChosenProposalModel

@{
    ViewData["Title"] = $"Edit Decision - {Model.CurrentFreeSchoolName}";
    var backLink = string.Format(RouteConstants.NewSchoolWhichProposalChosen, Model.ProjectId);
}

@section BeforeMain {
    <nav class="govuk-extra-width-container">
        <a href=@backLink class="govuk-back-link">Back</a>
    </nav>
}

<partial name="_ErrorSummary" />

<h1 class="govuk-heading-xl" data-testid="title">
    <span class="govuk-caption-l" data-testid="school-name">
        @Model.CurrentFreeSchoolName
    </span>
    Is this the right proposal?
</h1>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <p class="govuk-hint">
            You will not be able to change this answer.
        </p>

        <div class="govuk-inset-text">
            <p class="govuk-body govuk-!-font-weight-bold" data-testid="proposal-name">
                @Model.ProposalName
            </p>
        </div>

        <form method="post">
            <govuk-yesno-input id="is-right-proposal"
                               name="is-right-proposal"
                               asp-for="@Model.IsRightProposal" />

            <button class="govuk-button" data-module="govuk-button" data-testid="continue">
                Continue
            </button>
        </form>
    </div>
</div>
