@page "/projects/{projectId}/tasks/local-authority/decision"
@using Dfe.ManageFreeSchoolProjects.Constants;

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.Decision.DecisionModel

@{
    ViewData["Title"] = $"Edit Decision - {Model.CurrentFreeSchoolName}";
    var backLink = string.Format(RouteConstants.TaskList, Model.ProjectId);
}

@section BeforeMain {
    <nav class="govuk-extra-width-container">
        <a href=@backLink class="govuk-back-link">Back</a>
    </nav>
}

<partial name="_ErrorSummary" />

<h1 class="govuk-heading-xl" data-testid="title">
    <span class="govuk-caption-l" data-testid="school-name">
        @Model.CurrentFreeSchoolName
    </span>
    What was the decision?
</h1>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <div class="govuk-form-group">
                <govuk-radios-input name="decision"
                                    asp-for="@Model.Decision"
                                    data-testid="decision"
                                    labels="@Model.Options.ToArray()"
                                    values="@Model.Options.ToArray()" />
            </div>

            <button class="govuk-button" data-module="govuk-button">
                Save and return
            </button>
        </form>
    </div>
</div>