@page "/projects/{projectId}/tasks/local-authority/{proposalId}/decision"
@using Dfe.ManageFreeSchoolProjects.Constants;
@using Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.Decision

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Tasks.LocalAuthority.Decision.DecisionModel

@{
    ViewData["Title"] = $"Edit Decision - {Model.CurrentFreeSchoolName}";
    var backLink = string.Format(RouteConstants.TaskList, Model.ProjectId);
}

@section BeforeMain {
    <nav class="govuk-extra-width-container">
        <a href=@backLink class="govuk-back-link">Back</a>
    </nav>
}

<partial name="_ErrorSummary" />

<h1 class="govuk-heading-xl" data-testid="title">
    <span class="govuk-caption-l" data-testid="school-name">
        @Model.CurrentFreeSchoolName
    </span>
    What was the decision?
</h1>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <div class="govuk-form-group">
                <govuk-radios-list>
                    <govuk-radios-list-item id="approved-without-conditions"
                                            value="@DecisionModel.ApprovedWithoutConditions"
                                            description="@DecisionModel.ApprovedWithoutConditions"
                                            asp-for="@Model.Decision"
                                            name="decision" />
                    <govuk-radios-list-conditional-item id="approved-with-conditions"
                                                        value="@DecisionModel.ApprovedWithConditions"
                                                        description="@DecisionModel.ApprovedWithConditions"
                                                        asp-for="@Model.Decision"
                                                        name="decision">
                        <govuk-textarea-input id="condition-description"
                                              name="condition-description"
                                              asp-for="@Model.ConditionDescription"
                                              test-id="condition-description"
                                              rows="10"
                                              label="What conditions have been applied?"
                                              bold-label="true" />
                    </govuk-radios-list-conditional-item>
                </govuk-radios-list>
            </div>

            <button class="govuk-button" data-module="govuk-button">
                Save and return
            </button>
        </form>
    </div>
</div>
