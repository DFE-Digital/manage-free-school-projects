@page "/projects/{projectId}/proposals/{rid}/details"
@using Dfe.ManageFreeSchoolProjects.Constants;
@using Microsoft.AspNetCore.Html
@using Dfe.ManageFreeSchoolProjects.API.Contracts.Project.Tasks
@model Dfe.ManageFreeSchoolProjects.Pages.Project.Proposals.ProposalDetailsModel

@{
    ViewData["Title"] = $"{Model.Project.ProjectStatus.CurrentFreeSchoolName} - Proposal details";

    ViewData["WidePage"] = true;
    var projectStatusViewModel = new ProjectStatusViewModel()
    {
        ProjectId = @Model.ProjectId,
        ProjectStatus = @Model.Project.ProjectStatus.ProjectStatus,
        Referrer = Referrer.Proposals
    };

    var currentNavIndex = NavConstants.NavItemList.FindIndex(item => item.Description == "Proposals");
}

@section BeforeMain
{
    <mfsp-project-header project-id="@Model.ProjectId"
                         school-name="@Model.Project.ProjectStatus.CurrentFreeSchoolName"
                         back-link="/"
                         back-text="Back"
                         page-title="Proposals"
                         project-status="@projectStatusViewModel" />
}

<div class="govuk-grid-row">
    <mfsp-nav project-id="@Model.ProjectId" project-type="@Model.Project.ProjectType" current-index="@currentNavIndex" />
    <div class="govuk-grid-column-three-quarters">
        <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Proposal</h2>

        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Type of proposer</dt>
                <dd class="govuk-summary-list__value" data-testid="proposer">@Model.Proposal.Proposer.ToDescription()</dd>
            </div>

            @if (Model.Proposal.Proposer == ProposalProposer.AcademyTrust)
            {
                @RenderSummaryRow("Trust reference number", Model.Proposal.TrustReferenceNumber, string.Format(RouteConstants.Proposals_Edit_SearchTrustByTRN, Model.ProjectId, Model.Proposal.Rid))
                @RenderSummaryRow("Trust name", Model.Proposal.TrustName, string.Format(RouteConstants.Proposals_Edit_SearchTrustByTRN, Model.ProjectId, Model.Proposal.Rid))
                @RenderSummaryRow("Trust type", Model.Proposal.TrustType.ToDescription(), string.Format(RouteConstants.Proposals_Edit_SearchTrustByTRN, Model.ProjectId, Model.Proposal.Rid))
            }

            @RenderSummaryRow("Is the proposal for a school with a religious character or religious ethos", Model.Proposal.ProposedFaithStatus.ToString(), string.Format(RouteConstants.Proposals_Edit_Proposed_Faith_Status, Model.ProjectId, Model.Proposal.Rid))
            @RenderSummaryRow("Proposed faith of new school", Model.Proposal.ProposedFaithType.ToDescription(), string.Format(RouteConstants.Proposals_Edit_Proposed_Faith_Type, Model.ProjectId, Model.Proposal.Rid))
            @RenderSummaryRow("If other, which faith is it", Model.Proposal.OtherFaithType, string.Format(RouteConstants.Proposals_Edit_Proposed_Faith_Type, Model.ProjectId, Model.Proposal.Rid))
        
        </dl>
    </div>
</div>

@functions {
    private static IHtmlContent RenderSummaryRow(string key, string value, string link, string visuallyHiddenText = "", string testId = "")
    {
        var renderedValue = string.IsNullOrEmpty(value) || value == "NotSet"
            ? "<span class=\"empty\">Empty</span>"
            : value;

        var htmlString = $@"
        <div class=""govuk-summary-list__row"">
            <dt class=""govuk-summary-list__key"">{key}</dt>
            <dd class=""govuk-summary-list__value"" data-testid=""{testId}"">{renderedValue}</dd>
            <dd class=""govuk-summary-list__actions"">
                <a class=""govuk-link"" href=""{link}"">Change<span class=""govuk-visually-hidden"">{visuallyHiddenText}</span></a>
            </dd>
        </div>";

        return new HtmlString(htmlString);
    }
}