@page "/projects/{projectId}/proposals/create/joint-proposal-local-authority"
@model Dfe.ManageFreeSchoolProjects.Pages.Project.Proposals.Create.JointProposalLocalAuthorityModel
@using Dfe.ManageFreeSchoolProjects.ViewModels

@{
    var title = "What is the other local authority?";
    ViewData["Title"] = title;
}

@section BeforeMain {
    <nav class="govuk-extra-width-container">
        <a href="@Model.BackLink" class="govuk-back-link" data-testid="back">Back</a>
    </nav>
}

<partial name="_ProposalLocalAuthoritySelection"
         model="@(new ProposalLocalAuthoritySelectionViewModel {
             Title = title,
             LocalAuthority = Model.LocalAuthority,
             LocalAuthorities = Model.LocalAuthorities })" />
