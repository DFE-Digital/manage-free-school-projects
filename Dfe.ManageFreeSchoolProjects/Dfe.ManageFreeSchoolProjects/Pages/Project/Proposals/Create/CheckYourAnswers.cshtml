@page "/projects/{projectId}/proposals/create/check-your-answers"
@model Dfe.ManageFreeSchoolProjects.Pages.Project.Proposals.Create.CheckYourAnswersModel
@using Microsoft.AspNetCore.Html
@using Dfe.ManageFreeSchoolProjects.Constants
@using Dfe.ManageFreeSchoolProjects.API.Contracts.Project.Tasks
@using Dfe.ManageFreeSchoolProjects.ViewHelpers

@{
    ViewData["Title"] = "Check your answers";
}

<div class="govuk-grid-row">
    <partial name="_ErrorSummary" />

    <div class="govuk-grid-column-two-thirds-from-desktop">
        <govuk-create-proposal-title label="Check your answers before you submit" add-margin="true" />

        <dl class="govuk-summary-list">
            @ProposalSummary.RenderSummaryRow("Type of proposer", Model.Cache.Proposer.ToDescription(), RouteConstants.Proposals_Create_Proposer)

            @if (Model.Cache.Proposer == ProposalProposer.AcademyTrust)
            {
                @ProposalSummary.RenderSummaryRow("Trust reference number", Model.Cache.Trust.TRN, RouteConstants.Proposals_Create_SearchTrustByTRN)
                @ProposalSummary.RenderSummaryRow("Trust name", Model.Cache.Trust.TrustName, RouteConstants.Proposals_Create_SearchTrustByTRN)
                @ProposalSummary.RenderSummaryRow("Trust type", Model.Cache.Trust.TrustType.ToDescription(), RouteConstants.Proposals_Create_SearchTrustByTRN)
            }
            else if (Model.Cache.Proposer == ProposalProposer.Diocese)
            {
                @ProposalSummary.RenderSummaryRow("Name of Diocese", Model.Cache.NameOfDiocese, RouteConstants.Proposals_Create_Name_Of_Diocese)
                @ProposalSummary.RenderSummaryRow("Faith of Diocese", Model.Cache.FaithOfDiocese.ToDescription(), RouteConstants.Proposals_Create_Faith_Of_Diocese)
            }
            else if (Model.Cache.Proposer == ProposalProposer.AnotherReligiousOrganisation)
            {
                @ProposalSummary.RenderSummaryRow("Name of other religious organistation", Model.Cache.NameOfOtherReligiousOrganisation, RouteConstants.Proposals_Create_Name_Of_Other_Religious_Organisation)
                @ProposalSummary.RenderSummaryRow("Faith of other religious organisation", Model.Cache.FaithTypeOfOtherReligiousOrganisation.ToDescription(), RouteConstants.Proposals_Create_Faith_Of_Other_Religious_Organisation)
                @ProposalSummary.RenderSummaryRow("If other, which faith is it", Model.Cache.OtherFaithTypeOfOtherReligiousOrganisation, RouteConstants.Proposals_Create_Name_Of_Other_Religious_Organisation)
            }
            else if (Model.Cache.Proposer == ProposalProposer.AnotherLocalAuthority)
            {
                @ProposalSummary.RenderSummaryRow("Name of another Local authority", Model.Cache.OtherLocalAuthority, RouteConstants.Proposals_Create_Other_Local_Authority)
            }
            else if (Model.Cache.Proposer == ProposalProposer.JointProposal)
            {
                @ProposalSummary.RenderSummaryRow("Name of another LA that has submitted a joint proposal with the LA that has published the specification", Model.Cache.JointProposalLocalAuthority, RouteConstants.Proposals_Create_Joint_Proposal_Region)
            }

            @ProposalSummary.RenderSummaryRow("Is the proposal for a school with a religious character or religious ethos", Model.Cache.ProposedFaithStatus.ToString(), RouteConstants.Proposals_Create_Proposed_Faith_Status)
            @ProposalSummary.RenderSummaryRow("Proposed faith of new school", Model.Cache.ProposedFaithType.ToDescription(), RouteConstants.Proposals_Create_Proposed_Faith_Type)
            @ProposalSummary.RenderSummaryRow("If other, which faith is it", Model.Cache.OtherFaithType, RouteConstants.Proposals_Create_Proposed_Faith_Type)
        </dl>

        <h2 class="govuk-heading-m">Now create your proposal</h2>
        <p>By selecting the Create proposal button, you are confirming that you have approval to create proposals.</p>

        <form method="post" novalidate="">
            <button class="govuk-button" data-module="govuk-button" data-testid="create-proposal">
                Create proposal
            </button>
        </form>
    </div>
</div>
