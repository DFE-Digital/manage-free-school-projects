@page "/projects/{projectId}/proposals/create/check-your-answers"
@model Dfe.ManageFreeSchoolProjects.Pages.Project.Proposals.Create.CheckYourAnswersModel
@using Dfe.ManageFreeSchoolProjects.Constants
@using Dfe.ManageFreeSchoolProjects.API.Contracts.Project.Tasks
@using Dfe.ManageFreeSchoolProjects.ViewHelpers

@{
    ViewData["Title"] = "Check your answers";
}

<div class="govuk-grid-row">
    <partial name="_ErrorSummary" />

    <div class="govuk-grid-column-two-thirds-from-desktop">
        <govuk-create-proposal-title label="Check your answers before you submit" add-margin="true" />

        <dl class="govuk-summary-list">
            @ProposalSummary.RenderSummaryRow("Type of proposer", Model.Cache.Proposer.ToDescription(), string.Format(RouteConstants.Proposals_Create_Proposer, Model.ProjectId))

            @if (Model.Cache.Proposer == ProposalProposer.AcademyTrust)
            {
                @ProposalSummary.RenderSummaryRow("Trust reference number", Model.Cache.Trust.TRN, string.Format(RouteConstants.Proposals_Create_SearchTrustByTRN, Model.ProjectId))
                @ProposalSummary.RenderSummaryRow("Trust name", Model.Cache.Trust.TrustName, string.Format(RouteConstants.Proposals_Create_SearchTrustByTRN, Model.ProjectId))
                @ProposalSummary.RenderSummaryRow("Trust type", Model.Cache.Trust.TrustType.ToDescription(), string.Format(RouteConstants.Proposals_Create_SearchTrustByTRN, Model.ProjectId))
            }
            else if (Model.Cache.Proposer == ProposalProposer.Diocese)
            {
                @ProposalSummary.RenderSummaryRow("Name of Diocese", Model.Cache.NameOfDiocese, string.Format(RouteConstants.Proposals_Create_Name_Of_Diocese, Model.ProjectId))
                @ProposalSummary.RenderSummaryRow("Faith of Diocese", Model.Cache.FaithOfDiocese.ToDescription(), string.Format(RouteConstants.Proposals_Create_Faith_Of_Diocese, Model.ProjectId))
            }
            else if (Model.Cache.Proposer == ProposalProposer.AnotherReligiousOrganisation)
            {
                @ProposalSummary.RenderSummaryRow("Name of other religious organistation", Model.Cache.NameOfOtherReligiousOrganisation, string.Format(RouteConstants.Proposals_Create_Name_Of_Other_Religious_Organisation, Model.ProjectId))
                @ProposalSummary.RenderSummaryRow("Faith of other religious organisation", Model.Cache.FaithTypeOfOtherReligiousOrganisation.ToDescription(), string.Format(RouteConstants.Proposals_Create_Faith_Of_Other_Religious_Organisation, Model.ProjectId))
                @ProposalSummary.RenderSummaryRow("If other, which faith is it", Model.Cache.OtherFaithTypeOfOtherReligiousOrganisation, string.Format(RouteConstants.Proposals_Create_Name_Of_Other_Religious_Organisation, Model.ProjectId))
            }
            else if (Model.Cache.Proposer == ProposalProposer.AnotherLocalAuthority)
            {
                @ProposalSummary.RenderSummaryRow("Name of another Local authority", Model.Cache.OtherLocalAuthority, string.Format(RouteConstants.Proposals_Create_Other_Local_Authority, Model.ProjectId))
            }
            else if (Model.Cache.Proposer == ProposalProposer.JointProposal)
            {
                @ProposalSummary.RenderSummaryRow("Name of another LA that has submitted a joint proposal with the LA that has published the specification", Model.Cache.JointProposalLocalAuthority, string.Format(RouteConstants.Proposals_Create_Joint_Proposal_Region, Model.ProjectId))
            }

            @ProposalSummary.RenderSummaryRow("Is the proposal for a school with a religious character or religious ethos", Model.Cache.ProposedFaithStatus.ToString(), string.Format(RouteConstants.Proposals_Create_Proposed_Faith_Status, Model.ProjectId))
            @ProposalSummary.RenderSummaryRow("Proposed faith of new school", Model.Cache.ProposedFaithType.ToDescription(), string.Format(RouteConstants.Proposals_Create_Proposed_Faith_Type, Model.ProjectId))
            @ProposalSummary.RenderSummaryRow("If other, which faith is it", Model.Cache.OtherFaithType, string.Format(RouteConstants.Proposals_Create_Proposed_Faith_Type, Model.ProjectId))
        </dl>

        <h2 class="govuk-heading-m">Now create your proposal</h2>
        <p>By selecting the Create proposal button, you are confirming that you have approval to create proposals.</p>

        <form method="post" novalidate="">
            <button class="govuk-button" data-module="govuk-button" data-testid="create-proposal">
                Create proposal
            </button>
        </form>
    </div>
</div>
