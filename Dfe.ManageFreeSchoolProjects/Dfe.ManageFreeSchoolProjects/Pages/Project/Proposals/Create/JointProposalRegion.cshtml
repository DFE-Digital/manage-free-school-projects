@page "/projects/{projectId}/proposals/create/joint-proposal-region"
@model Dfe.ManageFreeSchoolProjects.Pages.Project.Proposals.Create.JointProposalRegionModel
@using Dfe.ManageFreeSchoolProjects.ViewModels

@{
    var title = "Which region is the other local authority in?";
    ViewData["Title"] = title;
}

@section BeforeMain {
    <nav class="govuk-extra-width-container">
        <a href="@Model.BackLink" class="govuk-back-link" data-testid="back">Back</a>
    </nav>
}

<partial name="_ProposalRegionSelection"
         model="@(new ProposalRegionSelectionViewModel { Title = title, Region = Model.Region })" />
