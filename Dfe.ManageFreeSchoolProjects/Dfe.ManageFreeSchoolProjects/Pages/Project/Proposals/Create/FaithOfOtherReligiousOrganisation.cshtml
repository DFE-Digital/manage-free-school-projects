@page "/projects/{projectId}/proposals/create/faith-of-other-religious-organisation"
@using Dfe.ManageFreeSchoolProjects.API.Contracts.Project.Tasks

@model Dfe.ManageFreeSchoolProjects.Pages.Project.Proposals.Create.FaithOfOtherReligiousOrganisationModel

@{
    ViewData["Title"] = "What is the faith type of the other religious organisation?";

    var faithTypes = Enum.GetValues<FaithType>().Except(new[] { FaithType.NotSet }).ToList();
    var faithTypeLabels = faithTypes.Select(x => x.ToDescription()).ToArray();
    var faithTypeValues = faithTypes.Select(x => x.ToString()).ToArray();
}

@section BeforeMain {
    <div role="navigation" class="govuk-extra-width-container">
        <a href="@Model.BackLink" class="govuk-back-link" data-testid="back">Back</a>
    </div>
}

<div class="govuk-grid-row">
    <partial name="_ErrorSummary" />
    <div class="govuk-grid-column-two-thirds">
        <form class="form" method="post">
            <govuk-create-proposal-title label="What is the faith type of the other religious organisation?" add-margin="true" />
            <govuk-radios-input id="faith-of-other-religious-organisation" name="faith-of-other-religious-organisation"
                                asp-for="@Model.FaithTypeOfOtherReligiousOrganisation"
                                data-testid="faith-of-other-religious-organisation"
                                labels="@faithTypeLabels"
                                values="@faithTypeValues" />
            <br />
            <button class="govuk-button" data-module="govuk-button" data-testid="continue">
                Continue
            </button>
        </form>
    </div>  
</div>

<script type="application/javascript" asp-add-nonce>
    const setVisibility = () =>
    {
        $('#faith-of-other-religious-organisation').parent().show();

        if($("input[type='radio']:checked[name='faith-of-other-religious-organisation']").val() === 'Other')
        {
            $('#other-faith-of-other-religious-organisation').parent().show();
        }
        else
        {
            $('#other-faith-of-other-religious-organisation').parent().hide();
        }
    }

    $(document).ready(() => {
        setVisibility();

        $("input[type='radio'][name='faith-of-other-religious-organisation']").click((e) => {
            setVisibility();
        });
    });
</script>