@page "/projects/{projectId}/proposals/create/faith-of-other-religious-organisation"
@model Dfe.ManageFreeSchoolProjects.Pages.Project.Proposals.Create.FaithOfOtherReligiousOrganisationModel
@using Dfe.ManageFreeSchoolProjects.ViewModels

@{
    var title = "What is the faith type of the other religious organisation?";
    ViewData["Title"] = title;
}

@section BeforeMain {
    <partial name="_ProposalBackLink" model="@Model.BackLink" />
}

<partial name="_ProposalFaithTypeSelection"
         model="@(new ProposalFaithTypeSelectionViewModel
         {
             Title = title,
             FaithType = Model.FaithTypeOfOtherReligiousOrganisation.ToString(),
             OtherFaithType = Model.OtherFaithType
         })" />
